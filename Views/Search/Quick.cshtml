@{
    ViewBag.Title = "Rezultati pretrage";
    var vozila = ViewBag.Vozila as List<AutoServisWeb.Models.Vozila> ?? new List<AutoServisWeb.Models.Vozila>();
    var servisi = ViewBag.Servisi as List<AutoServisWeb.Models.Servisi> ?? new List<AutoServisWeb.Models.Servisi>();
    string q = ViewBag.Query as string ?? "";
}

<h2 class="mb-1">Pretraga: <em>@q</em></h2>
<p class="text-muted mb-4">Pronadjeno @vozila.Count vozila i @servisi.Count servisa.</p>

<h5>Vozila</h5>
@if (vozila.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var v in vozila)
        {
            string markaNaziv = v.Marke != null ? v.Marke.NazivMarke : "";
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title">@markaNaziv @v.Model</h6>
                        <p class="card-text text-muted small mb-0">@v.RegistarskaOznaka &middot; @v.GodinaProizvodnje</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        @Html.ActionLink("Detalji", "Details", "Vozila", new { id = v.VoziloID }, new { @class = "btn btn-sm btn-outline-info" })
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{ <p class="text-muted mb-4">Nema vozila koja odgovaraju pretrazi.</p>}

<h5>Servisi</h5>
@if (servisi.Any())
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>Datum</th><th>Vozilo</th><th>Opis</th><th class="text-end">Cijena (RSD)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in servisi)
            {
                <tr>
                    <td>@s.DatumServisa.ToString("dd.MM.yyyy")</td>
                    <td>@(s.Vozila != null ? s.Vozila.RegistarskaOznaka : "-")</td>
                    <td>@s.OpisRadova</td>
                    <td class="text-end">@s.UkupnaCena.ToString("N2")</td>
                    <td>@Html.ActionLink("Detalji", "Details", "Servis", new { id = s.ServisID }, new { @class = "btn btn-sm btn-outline-info" })</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{ <p class="text-muted">Nema servisa koji odgovaraju pretrazi.</p>}

<div class="mt-3">
    @Html.ActionLink("Detaljna pretraga", "Index", "Search", null, new { @class = "btn btn-outline-secondary" })
</div>