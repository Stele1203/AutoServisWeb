@model AutoServisWeb.ViewModels.SearchViewModel
@{ ViewBag.Title = "Pretraga"; }

<h2>Pretraga</h2>
<hr />

@using (Html.BeginForm("Index", "Search", FormMethod.Get))
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Kljucna rijec</label>
                    @Html.TextBoxFor(m => m.KljucnaRec, new { @class = "form-control", placeholder = "Registracija, model, sasija, opis..." })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Marka vozila</label>
                    @Html.DropDownListFor(m => m.MarkaID, Model.Marke, "-- Sve marke --", new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">Godina od</label>
                    @Html.TextBoxFor(m => m.GodinaOd, new { @class = "form-control", placeholder = "npr. 2000" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">Godina do</label>
                    @Html.TextBoxFor(m => m.GodinaDo, new { @class = "form-control", placeholder = "npr. 2024" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Kategorija servisa</label>
                    @Html.DropDownListFor(m => m.KategorijaID, Model.Kategorije, "-- Sve kategorije --", new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cijena od (RSD)</label>
                    @Html.TextBoxFor(m => m.CenaOd, new { @class = "form-control", placeholder = "0" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cijena do (RSD)</label>
                    @Html.TextBoxFor(m => m.CenaDo, new { @class = "form-control", placeholder = "99999" })
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-dark me-2 w-100">Pretrazi</button>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-outline-secondary w-100">Resetuj</a>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.PretrazivanjeIzvrseno)
{
    <h5>Pronadjeno @Model.ServisRezultati.Count rezultata</h5>

    if (Model.ServisRezultati.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Vozilo</th>
                        <th>Marka</th>
                        <th>Registracija</th>
                        <th>Datum servisa</th>
                        <th>Kategorija</th>
                        <th>Opis</th>
                        <th class="text-end">Cijena (RSD)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.ServisRezultati)
                    {
                        <tr>
                            <td>
                                @if (s.Vozila != null)
                                {
                                    @Html.ActionLink(s.Vozila.Model, "Details", "Vozila",
                                        new { id = s.Vozila.VoziloID },
                                        new { @class = "text-decoration-none fw-semibold" })
                                }
                                else
                                { <text>-</text>}
                            </td>
                            <td>@(s.Vozila != null && s.Vozila.Marke != null ? s.Vozila.Marke.NazivMarke : "-")</td>
                            <td><span class="badge bg-secondary">@(s.Vozila != null ? s.Vozila.RegistarskaOznaka : "-")</span></td>
                            <td>@s.DatumServisa.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (s.KategorijeServisa != null)
                                {<span class="badge bg-info text-dark">@s.KategorijeServisa.NazivKategorije</span>}
                            </td>
                            <td>@s.OpisRadova</td>
                            <td class="text-end fw-semibold">@s.UkupnaCena.ToString("N2")</td>
                            <td>
                                @Html.ActionLink("Detalji", "Details", "Servis",
                                    new { id = s.ServisID },
                                    new { @class = "btn btn-sm btn-outline-info" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">Nema rezultata koji odgovaraju pretrazi.</div>
    }
}