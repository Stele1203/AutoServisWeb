@model AutoServisWeb.Models.Vozila
@{ ViewBag.Title = "Novo vozilo"; }

<h2>Dodaj vozilo</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.MarkaID, "Marka")
                @Html.DropDownList("MarkaID", null, "-- Odaberite marku --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.MarkaID, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Model)
                @Html.EditorFor(m => m.Model, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Model, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.GodinaProizvodnje, "Godina proizvodnje")
                @Html.EditorFor(m => m.GodinaProizvodnje, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.GodinaProizvodnje, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.RegistarskaOznaka, "Registarska oznaka")
                @Html.EditorFor(m => m.RegistarskaOznaka, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.BrojSasije, "Broj sasije")
                @Html.EditorFor(m => m.BrojSasije, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.KorisnikID, "Vlasnik")
                @Html.DropDownList("KorisnikID", null, "-- Odaberite vlasnika --", new { @class = "form-select" })
            </div>
            <button type="submit" class="btn btn-primary">Sacuvaj</button>
            @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}