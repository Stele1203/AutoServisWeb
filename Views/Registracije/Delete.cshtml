@model AutoServisWeb.Models.Registracije
@{ ViewBag.Title = "Obrisi registraciju"; }

<h2>Potvrda brisanja</h2>
<hr />
<p class="text-danger">Da li ste sigurni da zelite obrisati ovu registraciju?</p>

<dl class="row">
    <dt class="col-sm-3">Vozilo</dt>
    <dd class="col-sm-9">@(Model.Vozila != null ? Model.Vozila.RegistarskaOznaka : "-")</dd>
    <dt class="col-sm-3">Datum isteka</dt>
    <dd class="col-sm-9">@Model.DatumIsteka.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-3">Cijena</dt>
    <dd class="col-sm-9">@Model.CenaRegistracije.ToString("N2") RSD</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Obrisi</button>
    @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary ms-2" })
}