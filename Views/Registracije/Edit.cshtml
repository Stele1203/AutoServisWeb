@model AutoServisWeb.Models.Registracije
@{ ViewBag.Title = "Uredi registraciju"; }

<h2>Uredi registraciju</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.RegistracijaID)
    <div class="row">
        <div class="col-md-5">
            <div class="mb-3">
                @Html.LabelFor(m => m.VoziloID, "Vozilo")
                @Html.DropDownList("VoziloID", null, "-- Odaberite vozilo --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.DatumIsteka, "Datum isteka")
                @Html.EditorFor(m => m.DatumIsteka, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.CenaRegistracije, "Cijena registracije (RSD)")
                @Html.EditorFor(m => m.CenaRegistracije, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <button type="submit" class="btn btn-warning">Sacuvaj izmjene</button>
            @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}