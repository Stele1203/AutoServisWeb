<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AutoDnevnik</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        html, body { height: 100%; }
        body { display: flex; flex-direction: column; background-color: #f8f9fa; }
        .main-content { flex: 1; }
        .site-footer { background: #212529; color: #adb5bd; padding: 1.2rem 0; }
        .navbar-brand { font-weight: 700; letter-spacing: 1px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            @Html.ActionLink("AutoDnevnik", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">@Html.ActionLink("Pocetna", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Vozila", "Index", "Vozila", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Servisi", "Index", "Servis", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Registracije", "Index", "Registracije", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Mehanicari", "Index", "Mehanicari", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Pretraga", "Index", "Search", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>

                @using (Html.BeginForm("Quick", "Search", FormMethod.Get, new { @class = "d-flex me-3", role = "search" }))
                {
                    <input class="form-control form-control-sm me-1" type="search" name="q"
                           placeholder="Brza pretraga..." style="width:180px" />
                    <button class="btn btn-sm btn-outline-light" type="submit">Trazi</button>
                }

                <ul class="navbar-nav">
                    @if (Session["KorisnikID"] != null)
                    {
                        bool jeAdmin = (Session["UlogaID"] as int?) == 1;
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (jeAdmin)
                                { <span class="badge bg-danger px-2 py-1">Admin</span> }
                                else
                                { <span class="badge bg-primary px-2 py-1">Korisnik</span> }
                                <span>@Session["Ime"]</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width:220px">
                                <li class="px-3 py-2 text-muted small border-bottom">
                                    Prijavljeni kao<br />
                                    <strong class="text-dark">@Session["Ime"]</strong>
                                </li>
                                @if (jeAdmin)
                                {
                                    <li class="px-3 pt-2 pb-1">
                                        <span class="text-uppercase text-muted" style="font-size:.7rem">Admin panel</span>
                                    </li>
                                    <li><a class="dropdown-item" href="@Url.Action("Korisnici", "Admin")">Upravljanje korisnicima</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Create", "Vozila")">Dodaj vozilo</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Create", "Servis")">Dodaj servis</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Create", "Registracije")">Dodaj registraciju</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Create", "Mehanicari")">Dodaj mehanicara</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li>
                                    <a class="dropdown-item text-danger fw-semibold"
                                       href="@Url.Action("Logout", "Account")">Odjavi se</a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("Prijava", "Login", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Registracija", "Register", "Account", null, new { @class = "nav-link" })</li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 mb-4 main-content">
        @RenderBody()
    </div>

    <footer class="site-footer text-center">
        <div class="container">
            <span>&copy; @DateTime.Now.Year AutoDnevnik &mdash; pracenje vozila i servisa</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>