@model IEnumerable<AutoServisWeb.Models.Korisnici>
@{ ViewBag.Title = "Upravljanje korisnicima"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Korisnici</h2>
    <span class="badge bg-secondary fs-6">@Model.Count() ukupno</span>
</div>

@if (TempData["Uspjeh"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Uspjeh"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Greska"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Greska"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Ime i prezime</th>
                <th>Email</th>
                <th>Uloga</th>
                <th class="text-end">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                bool jeAdmin = k.UlogaID == 1;
                bool jeTrenutni = (Session["KorisnikID"] as int?) == k.KorisnikID;
                <tr class="@(jeTrenutni ? "table-primary" : "")">
                    <td class="text-muted small">@k.KorisnikID</td>
                    <td>
                        <strong>@k.Ime @k.Prezime</strong>
                        @if (jeTrenutni)
                        {<span class="badge bg-primary ms-1">Vi</span>}
                    </td>
                    <td>@k.Email</td>
                    <td>
                        @if (jeAdmin)
                        {<span class="badge bg-danger">Admin</span> }
                        else
                        { <span class="badge bg-info text-dark">Korisnik</span>}
                    </td>
                    <td class="text-end">
                        @Html.ActionLink("Uredi", "EditKorisnik", new { id = k.KorisnikID },
                            new { @class = "btn btn-sm btn-outline-warning" })
                        @Html.ActionLink("Lozinka", "ChangePassword", new { id = k.KorisnikID },
                            new { @class = "btn btn-sm btn-outline-secondary" })
                        @if (!jeTrenutni)
                        {
                            @Html.ActionLink("Obrisi", "DeleteKorisnik", new { id = k.KorisnikID },
                                new { @class = "btn btn-sm btn-outline-danger" })
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>