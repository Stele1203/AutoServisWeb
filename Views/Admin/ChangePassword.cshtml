@model AutoServisWeb.ViewModels.ChangePasswordViewModel
@{ ViewBag.Title = "Promjena lozinke"; }

<h2>Promjena lozinke — @ViewBag.ImePrezime</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.KorisnikID)
    <div class="row">
        <div class="col-md-5">
            <div class="mb-3">
                @Html.LabelFor(m => m.NovaLozinka, "Nova lozinka")
                @Html.PasswordFor(m => m.NovaLozinka, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NovaLozinka, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.PotvrdaLozinke, "Potvrda lozinke")
                @Html.PasswordFor(m => m.PotvrdaLozinke, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PotvrdaLozinke, "", new { @class = "text-danger" })
            </div>
            <button type="submit" class="btn btn-warning">Promijeni</button>
            @Html.ActionLink("Odustani", "Korisnici", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}