@model AutoServisWeb.Models.Servisi
@{ ViewBag.Title = "Uredi servis"; }

<h2>Uredi servis</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ServisID)
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.VoziloID, "Vozilo")
                @Html.DropDownList("VoziloID", null, "-- Odaberite vozilo --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.MehanicarID, "Mehanicar")
                @Html.DropDownList("MehanicarID", null, "-- Odaberite mehanicara --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.KategorijaID, "Kategorija")
                @Html.DropDownList("KategorijaID", null, "-- Odaberite kategoriju --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.DatumServisa, "Datum servisa")
                @Html.EditorFor(m => m.DatumServisa, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Kilometraza, "Kilometraza")
                @Html.EditorFor(m => m.Kilometraza, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.OpisRadova, "Opis radova")
                @Html.TextAreaFor(m => m.OpisRadova, new { @class = "form-control", rows = 3 })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.UkupnaCena, "Ukupna cijena (RSD)")
                @Html.EditorFor(m => m.UkupnaCena, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <button type="submit" class="btn btn-warning">Sacuvaj izmjene</button>
            @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}