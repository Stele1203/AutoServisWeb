@{
    ViewBag.Title = "Pocetna";
}

<div class="text-center py-5">
    <h1 class="display-4">AutoDnevnik</h1>
    <p class="lead text-muted">Pratite odrzavanje, servise i troskove svojih vozila na jednom mjestu.</p>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-3">
        <div class="card h-100 border-primary">
            <div class="card-body text-center">
                <h5 class="card-title">Vozila</h5>
                <p class="card-text text-muted">Pregledajte i upravljajte registrovanim vozilima.</p>
                @Html.ActionLink("Otvori", "Index", "Vozila", null, new { @class = "btn btn-primary mt-2" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-success">
            <div class="card-body text-center">
                <h5 class="card-title">Servisi</h5>
                <p class="card-text text-muted">Evidentirajte servisne intervencije i troskove.</p>
                @Html.ActionLink("Otvori", "Index", "Servis", null, new { @class = "btn btn-success mt-2" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-warning">
            <div class="card-body text-center">
                <h5 class="card-title">Registracije</h5>
                <p class="card-text text-muted">Pratite datume isteka registracija.</p>
                @Html.ActionLink("Otvori", "Index", "Registracije", null, new { @class = "btn btn-warning mt-2" })
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-info">
            <div class="card-body text-center">
                <h5 class="card-title">Mehanicari</h5>
                <p class="card-text text-muted">Upravljajte kontaktima servisnih radionica.</p>
                @Html.ActionLink("Otvori", "Index", "Mehanicari", null, new { @class = "btn btn-info mt-2" })
            </div>
        </div>
    </div>
</div>