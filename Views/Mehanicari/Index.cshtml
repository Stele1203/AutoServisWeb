@model IEnumerable<AutoServisWeb.Models.Mehanicari>
@{
    ViewBag.Title = "Mehanicari";
    bool isAdmin = (Session["UlogaID"] as int?) == 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Mehanicari</h2>
    @if (isAdmin)
    {
        @Html.ActionLink("+ Dodaj mehanicara", "Create", null, new { @class = "btn btn-primary" })
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nema registrovanih mehanicara.</div>
}
else
{
    <div class="row g-3">
        @foreach (var m in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-1">@m.ImePrezime</h5>
                        @if (!string.IsNullOrEmpty(m.Telefon))
                        {<p class="mb-1 text-muted small">Tel: @m.Telefon</p>}
                        @if (!string.IsNullOrEmpty(m.AdresaRadionice))
                        {<p class="mb-0 text-muted small">Adresa: @m.AdresaRadionice</p>}
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        @Html.ActionLink("Detalji", "Details", new { id = m.MehanicarID }, new { @class = "btn btn-sm btn-outline-info" })
                        @if (isAdmin)
                        {
                            @Html.ActionLink("Uredi", "Edit", new { id = m.MehanicarID }, new { @class = "btn btn-sm btn-outline-warning" })
                            @Html.ActionLink("Obrisi", "Delete", new { id = m.MehanicarID }, new { @class = "btn btn-sm btn-outline-danger" })
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}