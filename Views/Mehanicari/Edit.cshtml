@model AutoServisWeb.Models.Mehanicari
@{ ViewBag.Title = "Uredi mehanicara"; }

<h2>Uredi mehanicara</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MehanicarID)
    <div class="row">
        <div class="col-md-5">
            <div class="mb-3">
                @Html.LabelFor(m => m.ImePrezime, "Ime i prezime")
                @Html.EditorFor(m => m.ImePrezime, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Telefon)
                @Html.EditorFor(m => m.Telefon, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.AdresaRadionice, "Adresa radionice")
                @Html.EditorFor(m => m.AdresaRadionice, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <button type="submit" class="btn btn-warning">Sacuvaj izmjene</button>
            @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}