@model AutoServisWeb.Models.Mehanicari
@{
    ViewBag.Title = "Detalji mehanicara";
    bool isAdmin = (Session["UlogaID"] as int?) == 1;
}

<h2>@Model.ImePrezime</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@(Model.Telefon ?? "-")</dd>
    <dt class="col-sm-3">Adresa radionice</dt>
    <dd class="col-sm-9">@(Model.AdresaRadionice ?? "-")</dd>
    <dt class="col-sm-3">Broj servisa</dt>
    <dd class="col-sm-9">@Model.Servisis.Count</dd>
</dl>

<div class="mt-3 d-flex gap-2">
    @if (isAdmin)
    {
        @Html.ActionLink("Uredi", "Edit", new { id = Model.MehanicarID }, new { @class = "btn btn-warning" })
    }
    @Html.ActionLink("Nazad", "Index", null, new { @class = "btn btn-secondary" })
</div>